# Embeds files as C byte arrays.
# Usage: cmake -DOUTPUT=out.c -DINPUTS="name1=path1;name2=path2" -P embed.cmake
set(content "/* Generated by cmake/embed.cmake. Do not edit. */\n#include <stddef.h>\n\n")
foreach(entry IN LISTS INPUTS)
    string(REPLACE "=" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "const unsigned char ${name}_data[] = {${bytes}0x00};\n")
    string(APPEND content "const size_t ${name}_size = ${size};\n\n")
endforeach()
file(WRITE "${OUTPUT}" "${content}")
